# Local-to-Cloud Diagnostic Gateway - example configuration.
#
# Copy this file to ".env" (which is gitignored) and fill in the values you
# need. Every value is optional: with no .env file the agent runs fully local
# and cloud sync is simply disabled. Process environment variables always take
# precedence over the .env file, which takes precedence over the built-in
# defaults.

# --- Cloud sync ---------------------------------------------------------------
# Cloud endpoint base URL. HTTPS is required; plain http:// is allowed only for
# localhost / 127.0.0.1 / ::1 (local emulation). Leave empty to disable sync.
API_BASE_URL=

# Ingest API key (bearer token), 32-256 characters. Required when API_BASE_URL
# is set. Never commit a real key; this value is treated as a secret and is
# redacted from all log output and status screens.
AGENT_API_KEY=

# --- Identity -----------------------------------------------------------------
# Stable device identifier override. Pattern: ^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$.
# Leave empty to let the agent generate and persist a random identity.
DEVICE_ID=

# Human-readable display name sent to the cloud (1-64 printable chars).
# Defaults to the machine hostname.
DEVICE_NAME=

# --- Scheduling ---------------------------------------------------------------
# Interval in seconds between automatic scans for the "run" loop (300-86400).
TELEMETRY_INTERVAL_SECONDS=3600

# --- Storage and logging ------------------------------------------------------
# Live SQLite database path. Defaults to <data dir>/agent.db.
DATABASE_PATH=

# Demo SQLite database path. Defaults to <data dir>/demo.db.
DEMO_DATABASE_PATH=

# File log level: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO

# JSON log file path. Defaults to <data dir>/logs/agent.log.
LOG_FILE=

# --- Sync retry / batching ----------------------------------------------------
# Delivery attempts before an event is moved to DEAD_LETTER (1-20).
RETRY_LIMIT=5

# Exponential backoff base in seconds (1-3600).
RETRY_BACKOFF_BASE_SECONDS=60

# Exponential backoff cap in seconds (>= base, <= 86400).
RETRY_BACKOFF_MAX_SECONDS=3600

# Maximum events per sync request (1-10). Batches are additionally packed by
# serialized byte size.
SYNC_BATCH_SIZE=10

# Maximum sync requests performed per cycle (1-100).
SYNC_MAX_BATCHES_PER_CYCLE=5

# Per-request HTTP timeout in seconds (1-60).
HTTP_TIMEOUT_SECONDS=10

# --- CPU sampling -------------------------------------------------------------
# Number of CPU utilization samples to average (1-10).
CPU_SAMPLE_COUNT=3

# Seconds spent per CPU sample (0.1-5).
CPU_SAMPLE_INTERVAL_SECONDS=1.0

# --- Health thresholds --------------------------------------------------------
# CPU average utilization warning threshold, percent (1-100).
CPU_USAGE_WARNING_PERCENT=90

# Memory utilization warning threshold, percent (1-100).
MEMORY_USAGE_WARNING_PERCENT=90

# Disk usage warning threshold, percent (1-100).
DISK_USAGE_WARNING_PERCENT=85

# Disk usage critical threshold, percent (> warning, <= 100).
DISK_USAGE_CRITICAL_PERCENT=95

# Average network latency warning threshold, milliseconds (1-10000).
LATENCY_WARNING_MS=150

# Probe-failure (packet loss) warning threshold, percent (0-100).
PACKET_LOSS_WARNING_PERCENT=10

# Probe-failure (packet loss) UNSTABLE threshold, percent (> warning, <= 100).
PACKET_LOSS_UNSTABLE_PERCENT=30

# --- Network probing ----------------------------------------------------------
# Probes per target (1-10).
NETWORK_PROBE_COUNT=4

# Per-probe timeout in seconds (0.5-10).
NETWORK_PROBE_TIMEOUT_SECONDS=2.0

# Comma-separated internet reachability targets as host:port (1-5 items).
# IPv6 literals must be bracketed, e.g. [2606:4700:4700::1111]:443.
INTERNET_TARGETS=1.1.1.1:443,8.8.8.8:443

# Comma-separated DNS test hostnames (RFC 1123, 1-5 items).
DNS_TEST_HOSTNAMES=example.com,aws.amazon.com
